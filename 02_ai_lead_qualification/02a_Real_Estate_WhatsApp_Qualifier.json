{
  "name": "02a_Real_Estate_WhatsApp_Qualifier",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "fb-lead-webhook" },
      "name": "FB Lead Ad Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": { "resource": "message", "operation": "send", "message": "Hi {{ $json.name }}, saw you're interested in the new condo project. Are you looking to buy or rent? What is your budget?", "phoneNumber": "={{ $json.phone }}" },
      "name": "Send WhatsApp Initial Message",
      "type": "n8n-nodes-base.whatsapp",
      "typeVersion": 1,
      "position": [480, 300]
    },
    {
      "parameters": { "model": "gpt-4o-mini", "prompt": "={{ $json.body.reply }}\nExtract budget, timeline, and buyer type (investor vs own stay)." },
      "name": "OpenAI Lead Scorer",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [700, 300]
    },
    {
      "parameters": { "operation": "executeQuery", "query": "INSERT INTO lead_scores (name, budget, type, score) VALUES ('{{ $json.name }}', '{{ $json.budget }}', '{{ $json.buyer_type }}', {{ $json.score }});" },
      "name": "Save to Supabase",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [940, 300]
    },
    {
      "parameters": { "channel": "#hot-property-leads", "text": "🔥 HOT LEAD: {{ $json.name }} | Budget: {{ $json.budget }} | Type: {{ $json.buyer_type }}" },
      "name": "Slack Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1160, 300]
    }
  ],
  "connections": {
    "FB Lead Ad Webhook": { "main": [[{ "node": "Send WhatsApp Initial Message", "type": "main", "index": 0 }]] },
    "Send WhatsApp Initial Message": { "main": [[{ "node": "OpenAI Lead Scorer", "type": "main", "index": 0 }]] },
    "OpenAI Lead Scorer": { "main": [[{ "node": "Save to Supabase", "type": "main", "index": 0 }]] },
    "Save to Supabase": { "main": [[{ "node": "Slack Alert", "type": "main", "index": 0 }]] }
  }
}
