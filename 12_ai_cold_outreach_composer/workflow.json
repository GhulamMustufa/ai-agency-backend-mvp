{
  "name": "AI Cold Outreach Composer",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "list"
        },
        "options": {}
      },
      "id": "node-google-sheets-trigger",
      "name": "Google Sheets Trigger (New Lead)",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.zerobounce.net/v2/validate",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "api_key",
              "value": "YOUR_ZEROBOUNCE_API_KEY"
            },
            {
              "name": "email",
              "value": "={{ $json.Email }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-email-validation",
      "name": "Validate Email API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "value2": "valid"
            }
          ]
        }
      },
      "id": "node-if-valid",
      "name": "IF Email is Valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        600,
        300
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "messages": {
          "messageValues": [
            {
              "role": "system",
              "message": "You are an elite B2B SDR. Write a highly personalized, short (3 sentences max) cold email to a prospect. Use a casual but professional tone. Focus on how our AI automation agency can help their specific industry."
            },
            {
              "message": "Prospect Name: {{ $('Google Sheets Trigger (New Lead)').item.json.Name }}\nCompany: {{ $('Google Sheets Trigger (New Lead)').item.json.Company }}\nIndustry: {{ $('Google Sheets Trigger (New Lead)').item.json.Industry }}\nWrite the email now. Output JSON with 'subject' and 'body'."
            }
          ]
        },
        "options": {
          "responseFormat": "json_object"
        }
      },
      "id": "node-openai-compose",
      "name": "OpenAI: Compose Email",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [
        840,
        200
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Invalid_Leads",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Email": "={{ $('Google Sheets Trigger (New Lead)').item.json.Email }}",
            "Reason": "={{ $json.status }}"
          }
        },
        "options": {}
      },
      "id": "node-google-sheets-invalid",
      "name": "Log Invalid Lead",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        840,
        400
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Google Sheets Trigger (New Lead)').item.json.Email }}",
        "subject": "={{ $json.message.content.subject }}",
        "body": "={{ $json.message.content.body }}",
        "options": {}
      },
      "id": "node-gmail-send",
      "name": "Gmail: Send Outreach",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        1060,
        200
      ]
    }
  ],
  "connections": {
    "Google Sheets Trigger (New Lead)": {
      "main": [
        [
          {
            "node": "Validate Email API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Email API": {
      "main": [
        [
          {
            "node": "IF Email is Valid",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Email is Valid": {
      "main": [
        [
          {
            "node": "OpenAI: Compose Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Invalid Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI: Compose Email": {
      "main": [
        [
          {
            "node": "Gmail: Send Outreach",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
