{
  "name": "04e_Corporate_Training_SOW",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "training-sow-request" },
      "name": "Airtable Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": { "model": "gpt-4o", "prompt": "Client: {{ $json.body.client_name }}. Industry: {{ $json.body.industry }}. Training Topic: {{ $json.body.topic }}. Headcount: {{ $json.body.headcount }}.\nGenerate a massive, highly detailed 5-page Statement of Work (SOW) customized to their specific industry." },
      "name": "OpenAI Deep SOW Writer",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [480, 300]
    },
    {
      "parameters": { "operation": "create", "title": "SOW - {{ $json.body.client_name }}", "content": "={{ $json.sow_content }}" },
      "name": "Create Google Doc for Review",
      "type": "n8n-nodes-base.googleDocs",
      "typeVersion": 1,
      "position": [700, 300]
    },
    {
      "parameters": { "operation": "update", "baseId": "YOUR_BASE_ID", "tableId": "YOUR_TABLE_ID", "recordId": "={{ $json.body.record_id }}", "fields": { "SOW_Link": "={{ $json.doc_url }}", "Status": "Ready for Review" } },
      "name": "Update Airtable Record",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [940, 300]
    }
  ],
  "connections": {
    "Airtable Webhook Trigger": { "main": [[{ "node": "OpenAI Deep SOW Writer", "type": "main", "index": 0 }]] },
    "OpenAI Deep SOW Writer": { "main": [[{ "node": "Create Google Doc for Review", "type": "main", "index": 0 }]] },
    "Create Google Doc for Review": { "main": [[{ "node": "Update Airtable Record", "type": "main", "index": 0 }]] }
  }
}
