{
  "name": "Roofing - Dependency Free Chat Demo",
  "nodes": [
    {
      "parameters": {
        "public": true,
        "options": {}
      },
      "id": "node-chat-trigger",
      "name": "Chat Trigger",
      "type": "n8n-nodes-base.chatTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "webhookId": "roofing-chat-demo"
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "messages": {
          "messageValues": [
            {
              "role": "system",
              "message": "You are the AI Assistant for 'Apex Roofing'. The user is simulating a homeowner who just had their call missed by our crew. Write a friendly, 2-sentence reply apologizing for missing the call. Ask them if they are dealing with an emergency leak, or if they just want a free estimate on a new roof. Ask them to reply with a photo of their house if possible."
            },
            {
              "message": "={{ $json.action }}"
            }
          ]
        },
        "options": {
          "responseFormat": "text"
        }
      },
      "id": "node-openai-chat",
      "name": "OpenAI: Draft Reply",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.message.content }}",
        "options": {}
      },
      "id": "node-chat-response",
      "name": "Chat Response",
      "type": "n8n-nodes-base.webhookResponse",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    }
  ],
  "connections": {
    "Chat Trigger": {
      "main": [
        [
          {
            "node": "OpenAI: Draft Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI: Draft Reply": {
      "main": [
        [
          {
            "node": "Chat Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
