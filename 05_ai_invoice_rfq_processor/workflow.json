{
  "name": "05_AI_Invoice_PO_and_RFQ_Processor",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "process-pdf-document-webhook" },
      "name": "Inbound PDF Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "https://api.cloud.llamaindex.ai/api/parsing/upload",
        "options": {}
      },
      "name": "LlamaParse PDF OCR Extractor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "model": "claude-3-5-sonnet-20241022",
        "prompt": "=Extract line items, quantities, part numbers, and target prices from PDF text:\n{{ $json.text }}\n\nReturn structured JSON table."
      },
      "name": "Claude 3.5 Sonnet Line Item Extractor",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [700, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO rfq_line_items (rfq_number, company_name, part_number, quantity, unit_price) VALUES ('{{ $json.rfq_number }}', '{{ $json.company_name }}', '{{ $json.part_number }}', {{ $json.quantity }}, {{ $json.unit_price }}) RETURNING *;"
      },
      "name": "Insert Line Items to Supabase",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [920, 300]
    },
    {
      "parameters": {
        "channel": "#sales-engineering-rfqs",
        "text": "=📄 NEW RFQ PARSED: {{ $json.company_name }} (RFQ #{{ $json.rfq_number }})\nTotal Line Items: {{ $json.line_items_count }}\nDraft Quote Ready for Approval!"
      },
      "name": "Slack Quote Approval Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1140, 300]
    }
  ],
  "connections": {
    "Inbound PDF Webhook": { "main": [[{ "node": "LlamaParse PDF OCR Extractor", "type": "main", "index": 0 }]] },
    "LlamaParse PDF OCR Extractor": { "main": [[{ "node": "Claude 3.5 Sonnet Line Item Extractor", "type": "main", "index": 0 }]] },
    "Claude 3.5 Sonnet Line Item Extractor": { "main": [[{ "node": "Insert Line Items to Supabase", "type": "main", "index": 0 }]] },
    "Insert Line Items to Supabase": { "main": [[{ "node": "Slack Quote Approval Alert", "type": "main", "index": 0 }]] }
  }
}
