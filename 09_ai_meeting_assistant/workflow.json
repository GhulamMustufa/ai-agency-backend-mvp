{
  "name": "09_AI_Meeting_Assistant_and_Executive_Briefing",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "process-meeting-audio-webhook" },
      "name": "Meeting Audio Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "https://api.openai.com/v1/audio/transcriptions",
        "options": {}
      },
      "name": "OpenAI Whisper Speech-to-Text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "prompt": "=Analyze meeting transcript:\n{{ $json.text }}\n\nExtract key discussion points, decision summary, and structured action items assigned to team members."
      },
      "name": "OpenAI Executive Summarizer",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [700, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO meeting_notes (meeting_title, transcript_text, summary, action_items) VALUES ('{{ $json.meeting_title }}', '{{ $json.text }}', '{{ $json.summary }}', '{{ $json.action_items }}') RETURNING *;"
      },
      "name": "Save Meeting to Supabase",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [920, 300]
    },
    {
      "parameters": {
        "channel": "#team-meeting-notes",
        "text": "=📌 EXECUTIVE BRIEFING: {{ $json.meeting_title }}\n\nSummary:\n{{ $json.summary }}\n\nAction Items:\n{{ $json.action_items }}"
      },
      "name": "Send Briefing to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1140, 300]
    }
  ],
  "connections": {
    "Meeting Audio Webhook": { "main": [[{ "node": "OpenAI Whisper Speech-to-Text", "type": "main", "index": 0 }]] },
    "OpenAI Whisper Speech-to-Text": { "main": [[{ "node": "OpenAI Executive Summarizer", "type": "main", "index": 0 }]] },
    "OpenAI Executive Summarizer": { "main": [[{ "node": "Save Meeting to Supabase", "type": "main", "index": 0 }]] },
    "Save Meeting to Supabase": { "main": [[{ "node": "Send Briefing to Slack", "type": "main", "index": 0 }]] }
  }
}
