    "Wait 3 Days (Time to unbox)": { "main": [[{ "node": "Send Email Request", "type": "main", "index": 0 }]] },
    "Send Email Request": { "main": [[{ "node": "Wait for Email Reply", "type": "main", "index": 0 }]] },
